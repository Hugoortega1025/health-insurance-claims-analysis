# --- Secrets ---
.env
.env.*
!.env.example

# --- Data (raw/derived data is not committed; acquisition is scripted) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Local databases
*.duckdb
*.duckdb.wal
*.sqlite
*.db

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# --- Jupyter ---
.ipynb_checkpoints/

# --- Models / caches ---
models/artifacts/
*.pkl
*.joblib
.cache/

# --- Tableau (keep packaged workbooks .twbx out if they embed data extracts) ---
*.hyper
tableau/**/*.twbx

# --- OS / editors ---
.DS_Store
.vscode/
.idea/

# Tableau temporary/lock files
tableau/.~*

# Local-only working files (kept on this machine, not published)
CLAUDE.md
docs/project_log.md
